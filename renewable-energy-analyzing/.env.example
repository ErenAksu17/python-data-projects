# Copy to `.env` and adjust as needed. `.env` is git-ignored.
# The Eurostat API is public and key-less, so no secrets are required to run.
# These only tune the API's rate limiter.

# Max requests per window, per client IP, on /api routes.
RATE_LIMIT_MAX=120
# Rate-limit window length, in seconds.
RATE_LIMIT_WINDOW=60
